# Kestrix environment template
#
# Copy this file to .env and replace the empty values:
#   cp .env.template .env
#
# .env is ignored by Git. Do not commit tokens, passwords, webhook secrets, or
# the master-key file. The Makefile loads .env for local development, while
# Docker Compose also uses it for interpolation.

# -----------------------------------------------------------------------------
# Application server
# -----------------------------------------------------------------------------

# Host address for the HTTP server. Effective when config.yaml omits
# listen_addr; the file wins when both are set, --addr wins over both.
KESTRIX_ADDR=:8080

# Directory used by commands that work with local pipeline definitions.
# Effective when config.yaml omits pipeline.dir; the file wins when both
# are set, --dir wins over both.
KESTRIX_DIR=./examples

# HTTP listener timeouts, as Go duration strings. ReadTimeout covers request
# headers and body; WriteTimeout covers the response (POST /webhook can run a
# Git fetch before answering, so this must stay generous); IdleTimeout bounds
# a keep-alive connection between requests. Leave empty for the defaults:
# 30s, 120s, 120s.
KESTRIX_HTTP_READ_TIMEOUT=
KESTRIX_HTTP_WRITE_TIMEOUT=
KESTRIX_HTTP_IDLE_TIMEOUT=

# Maximum request body size, in bytes, for the /api subtree and for
# POST /webhook independently - a push payload carries file lists for up to
# twenty commits, so it gets its own, larger bound. A request over its bound
# is refused with 413. Leave empty for the defaults: 1048576 (1 MiB) and
# 8388608 (8 MiB).
KESTRIX_HTTP_MAX_BODY_BYTES=
KESTRIX_WEBHOOK_MAX_BODY_BYTES=

# -----------------------------------------------------------------------------
# Repository credential encryption
# -----------------------------------------------------------------------------

# Absolute path to a separately provisioned master-key file. This is a PATH,
# not the key itself. The file must contain either 32 raw bytes or 64 hex
# characters and must have mode 0600:
#   mkdir -p ~/.kestrix
#   (umask 077 && openssl rand -hex 32 > ~/.kestrix/master.key)
#   export KESTRIX_MASTER_KEY_PATH="$HOME/.kestrix/master.key"
#
# The same absolute path is used as the bind-mount source and as the path seen
# by Kestrix inside Docker. Never put the key contents in this file.
KESTRIX_MASTER_KEY_PATH=

# -----------------------------------------------------------------------------
# API authentication
# -----------------------------------------------------------------------------

# Absolute path to a separately provisioned JWT signing-key file, provisioned
# the same way as the master key above - a PATH, not the key itself. The file
# must contain either 32 raw bytes or 64 hex characters and must have mode
# 0600. It must not be the same file as KESTRIX_MASTER_KEY_PATH: a leaked
# signing key must not also imply a leaked credential-decryption key.
#   (umask 077 && openssl rand -hex 32 > ~/.kestrix/jwt.key)
#   export KESTRIX_JWT_SIGNING_KEY_PATH="$HOME/.kestrix/jwt.key"
#
# Kestrix refuses every /api request until an administrator account exists.
# Create the first one with the CLI once the server can reach the database:
#   kestrix user create --role admin <name>
KESTRIX_JWT_SIGNING_KEY_PATH=

# How long RequireAuth may serve an account's role and token version from an
# in-process cache before resolving it from the database again. This is the
# revocation latency: a deleted account, a changed role, or a changed
# password takes effect on the process that made the change immediately, and
# on every other process within this bound. 0 disables the cache (every
# request resolves fresh). Defaults to 5s.
KESTRIX_IDENTITY_CACHE_TTL=

# Login throttle: this many failed logins for one account name, or from one
# client address, within the window trip a 429 with Retry-After. A throttled
# attempt never reaches password verification. Defaults to 10 and 1m.
KESTRIX_LOGIN_MAX_ATTEMPTS=
KESTRIX_LOGIN_WINDOW=

# Set to true only when Kestrix sits behind a reverse proxy that sets
# X-Forwarded-For itself. When true, the login throttle keys the client
# address on the first hop of that header instead of the raw connection
# address. Leave false (the default) on a direct-facing deployment: trusting
# the header there lets any client forge its own throttle key. Set to true
# together with docker-compose.prod.yml's --profile tls; it is never set
# automatically just because KESTRIX_DOMAIN is configured.
KESTRIX_TRUST_PROXY_HEADER=

# Overrides the Content-Security-Policy Kestrix sends on every response
# except /docs/*. Leave empty to use the default tuned for the bundled UI
# (same-origin scripts and styles, no framing).
KESTRIX_CONTENT_SECURITY_POLICY=

# Marks the browser session cookie Secure. Defaults to true. Set to false
# only for a plain-HTTP development deployment on a non-loopback host (no
# TLS in front) - a Secure cookie is silently dropped by the browser there,
# and this is a downgrade, not a switch to flip in production.
KESTRIX_COOKIE_SECURE=

# -----------------------------------------------------------------------------
# Incoming webhook authentication
# -----------------------------------------------------------------------------

# Shared secret used to authenticate requests sent to POST /webhook when a
# delivery's project has no secret of its own (see PUT /api/projects/{name}
# for per-project secrets). For GitLab, configure the same value as the
# webhook Secret Token; Kestrix compares it with the X-Gitlab-Token header.
#
# BREAKING: verification fails closed. A delivery that matches neither this
# secret nor its project's own is rejected with 401 - including when this is
# left empty and the project has none either. There is no configuration that
# accepts an unverified delivery.
#
# BREAKING: when config.yaml sets webhook.secret, the file value wins and
# this variable is ignored. An operator who relied on the environment to
# override a committed placeholder must delete the key from the file.
KESTRIX_WEBHOOK_SECRET=

# Verification mode:
#   gitlab - compare X-Gitlab-Token (default and recommended for GitLab)
#   hmac   - verify X-Hub-Signature-256 using HMAC-SHA256
KESTRIX_WEBHOOK_METHOD=gitlab

# Maximum number of webhook events kept in history. Older events are discarded
# once the limit is exceeded, so the history table stays bounded. Must be a
# positive integer; leave empty to use the default of 1000.
#
# BREAKING: when config.yaml sets webhook.history_limit, the file value wins
# and this variable is ignored; delete the key from the file to let the
# environment apply.
KESTRIX_WEBHOOK_HISTORY_LIMIT=

# -----------------------------------------------------------------------------
# GitLab pipeline dispatch
# -----------------------------------------------------------------------------

# GitLab project ID whose pipeline should be triggered when dispatch is used.
# Empty disables dispatch. Must be a positive integer or startup fails.
#
# BREAKING: when config.yaml sets dispatch.project_id, the file value wins
# and this variable is ignored; delete the key from the file to let the
# environment apply.
KESTRIX_DISPATCH_PROJECT=

# GitLab base URL, including the scheme. Use the self-hosted URL when needed.
# Effective when config.yaml omits dispatch.gitlab_url; the file wins when
# both are set, --gitlab-url wins over both.
KESTRIX_GITLAB_URL=https://gitlab.com

# GitLab API token used only for outbound pipeline dispatch. It is unrelated to
# repository credentials used to clone/fetch remote source repositories.
#
# BREAKING: when config.yaml sets dispatch.gitlab_token, the file value wins
# and this variable is ignored; delete the key from the file to let the
# environment apply.
KESTRIX_GITLAB_TOKEN=

# -----------------------------------------------------------------------------
# Source cache
# -----------------------------------------------------------------------------

# Persistent directory for private bare Git mirrors. The directory must be
# writable by the Kestrix process. Default for host runs is ~/.kestrix/cache/git;
# production Compose sets /var/lib/kestrix/cache/git automatically.
KESTRIX_SOURCE_CACHE_DIR=

# Maximum age of an unused cache entry. Examples: 24h, 720h, 30d is not valid
# Go duration syntax (use 720h instead).
KESTRIX_SOURCE_CACHE_MAX_AGE=

# Maximum total cache size in bytes. Must be a positive integer.
KESTRIX_SOURCE_CACHE_MAX_BYTES=

# -----------------------------------------------------------------------------
# Task execution isolation
# -----------------------------------------------------------------------------
# BREAKING: task processes in every runner mode no longer inherit the
# Kestrix process environment. They receive a fixed base set (PATH, HOME,
# LANG, LC_ALL, TMPDIR, TERM, USER), the CI_* variables Kestrix sets, the
# pipeline's own resolved variables, and only host variables named here.
# KESTRIX_MASTER_KEY_PATH, KESTRIX_JWT_SIGNING_KEY_PATH, DATABASE_URL,
# KESTRIX_GITLAB_TOKEN, and KESTRIX_WEBHOOK_SECRET can never be listed; doing
# so refuses to start.

# Comma-separated host variable names forwarded to task processes verbatim.
# A pipeline that relied on an inherited host variable must list it here.
KESTRIX_RUNNER_ENV_PASSTHROUGH=

# Docker task hardening. All apply only to `docker` runner mode.
# Process-count limit. Must be a positive integer. Defaults to 256.
KESTRIX_RUNNER_DOCKER_PIDS=
# Memory limit, Docker syntax (e.g. 2g, 512m). Defaults to 2g.
KESTRIX_RUNNER_DOCKER_MEMORY=
# CPU limit, Docker syntax (e.g. 2, 0.5). Defaults to 2.
KESTRIX_RUNNER_DOCKER_CPUS=
# User to run as inside the container (e.g. 1000:1000). Empty runs as the
# image's default user - most images assume root at build time.
KESTRIX_RUNNER_DOCKER_USER=
# Network attached to the task container. "none" removes all network access.
# Defaults to bridge, since deploy tasks typically need egress.
KESTRIX_RUNNER_DOCKER_NETWORK=

# How long a cancelled task gets to exit (SIGTERM, then SIGKILL / `docker
# stop`) before it is forced. Defaults to 10s.
KESTRIX_RUNNER_CANCEL_GRACE=

# Maximum number of runs executing at once. A run triggered while every slot
# is busy is recorded "queued" and starts automatically as slots free. Must
# be a positive integer; leave empty to use the default of 2.
#
# BREAKING: when config.yaml sets runner.max_concurrent_runs, the file value
# wins and this variable is ignored; delete the key from the file to let the
# environment apply.
KESTRIX_RUNNER_MAX_CONCURRENT_RUNS=

# Maximum number of terminal (passed/failed/canceled) runs retained. Older
# runs are deleted once a run finishes and the limit is exceeded; a running,
# queued, or manual-approval-pending run is never deleted. Must be a positive
# integer; leave empty to use the default of 1000.
#
# BREAKING: when config.yaml sets runner.run_history_limit, the file value
# wins and this variable is ignored; delete the key from the file to let the
# environment apply.
KESTRIX_RUN_HISTORY_LIMIT=

# Maximum stored run output in bytes. Output beyond the bound is dropped and
# the stored output ends with a marker line naming the bound; the run's
# status is unaffected. Must be a positive integer; leave empty to use the
# default of 10485760 (10 MiB).
#
# BREAKING: when config.yaml sets runner.max_output_bytes, the file value
# wins and this variable is ignored; delete the key from the file to let the
# environment apply.
KESTRIX_RUNNER_MAX_OUTPUT_BYTES=

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------

# Enables GET /metrics in Prometheus text exposition format. Disabled
# (false) by default: the route does not exist at all until this is set,
# and enabling it never opens a public route - see KESTRIX_METRICS_TOKEN
# below. Must be a boolean; leave empty for the default of false.
#
# BREAKING: when config.yaml sets metrics.enabled, the file value wins and
# this variable is ignored; delete the key from the file to let the
# environment apply.
KESTRIX_METRICS_ENABLED=

# Bearer token a scraper presents to GET /metrics. With no token set, only a
# signed-in account (viewer role or above) can read the endpoint. Never
# echoed by the startup source report, a log line, or any API response.
#
# BREAKING: when config.yaml sets metrics.token, the file value wins and
# this variable is ignored; delete the key from the file to let the
# environment apply.
KESTRIX_METRICS_TOKEN=

# Minimum level written to the structured (JSON) process log: debug, info,
# warn, or error. Must be one of those four values; leave empty to use the
# default of info.
#
# BREAKING: when config.yaml sets logging.level, the file value wins and
# this variable is ignored; delete the key from the file to let the
# environment apply.
KESTRIX_LOG_LEVEL=

# Host variables for tasks (not Kestrix settings). Kestrix itself never reads
# these; the dogfood pipeline's scripts receive them only when named in
# KESTRIX_RUNNER_ENV_PASSTHROUGH above. Registry settings used by Docker
# build/deploy pipeline tasks. They are not used for Git repository
# authentication.
DOCKER_REGISTRY=
DOCKER_IMAGE=kestrix
DOCKER_USERNAME=
DOCKER_PASSWORD=

# -----------------------------------------------------------------------------
# Docker deployment and local Compose ports
# -----------------------------------------------------------------------------

# Host-published ports used by Docker Compose. These do not configure the
# internal Kestrix/PostgreSQL ports. POSTGRES_PORT always publishes in the
# local dev Compose file; in the production file it only takes effect with
# `--profile db-port` (see POSTGRES_BIND_HOST below).
KESTRIX_PORT=8080
POSTGRES_PORT=5433
BUSINESS_PORT=8082
BUSINESS_BIND_HOST=127.0.0.1

# Remote host the dogfood pipeline's deploy task ships to. Only meaningful
# together with KESTRIX_RUNNER_ENV_PASSTHROUGH above.
DEPLOY_HOST=

# -----------------------------------------------------------------------------
# Production Compose (docker/docker-compose.prod.yml)
# -----------------------------------------------------------------------------

# Required. The database container refuses to start without it, and it is
# also substituted verbatim into the Kestrix DATABASE_URL
# (postgres://kestrix:<this value>@postgres:5432/kestrix) - Compose has no
# way to URL-escape it. Generate one with the command below; it produces
# only [0-9a-f], so it is always safe in that position. If you set this by
# hand instead, avoid @ : / ? # % - each of those breaks the composed URL
# silently (wrong host/database, or a connection failure) rather than
# refusing to start.
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Interface the --profile db-port relay binds to (see POSTGRES_PORT above).
# Defaults to loopback-only; set to 0.0.0.0 (or a specific host address) to
# reach PostgreSQL from outside this host - only do that on a trusted
# network, since the relay has no authentication of its own beyond
# PostgreSQL's.
POSTGRES_BIND_HOST=127.0.0.1

# Domain to obtain a TLS certificate for when the production deployment is
# started with `--profile tls`. Required in that profile; DNS must resolve it
# to this host and ports 80/443 must be reachable from the internet.
KESTRIX_DOMAIN=

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------

# Database used by a host-run Kestrix process. Docker Compose supplies its own
# service-internal DATABASE_URL and overrides this value for the container.
DATABASE_URL=postgres://kestrix:kestrix@localhost:5433/kestrix_local?sslmode=disable

# Test-only database. Tests refuse to connect to a database whose name does not
# end in _test. Never point this at the development or production database.
KESTRIX_TEST_DATABASE_URL=postgres://kestrix:kestrix@localhost:5433/kestrix_test?sslmode=disable
