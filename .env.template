# Kestrix Environment Variables
# Copy to .env and fill in values: cp .env.template .env

# Server
KESTRIX_ADDR=:8080
KESTRIX_DIR=./examples

# Webhook security
KESTRIX_WEBHOOK_SECRET=
KESTRIX_WEBHOOK_METHOD=gitlab

# GitLab dispatch
KESTRIX_DISPATCH_PROJECT=
KESTRIX_GITLAB_URL=https://gitlab.com
KESTRIX_GITLAB_TOKEN=

# Docker
POSTGRES_PORT=5433
REDIS_PORT=6380

# Local development database (deployment supplies its own DATABASE_URL)
DATABASE_URL=postgres://kestrix:kestrix@localhost:5433/kestrix_local?sslmode=disable

# Test database (separate from dev DB; tests refuse non-_test databases)
KESTRIX_TEST_DATABASE_URL=postgres://kestrix:kestrix@localhost:5433/kestrix_test?sslmode=disable
