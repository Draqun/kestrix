# MetaCI Environment Variables
# Copy to .env and fill in values: cp .env.template .env

# Server
METACI_ADDR=:8080
METACI_DIR=./examples

# Webhook security
METACI_WEBHOOK_SECRET=
METACI_WEBHOOK_METHOD=gitlab

# GitLab dispatch
METACI_DISPATCH_PROJECT=
METACI_GITLAB_URL=https://gitlab.com
METACI_GITLAB_TOKEN=

# Docker
POSTGRES_PORT=5432
REDIS_PORT=6379

# Test database (separate from dev DB; tests refuse non-_test databases)
METACI_TEST_DATABASE_URL=postgres://metaci:metaci@localhost:5432/metaci_test?sslmode=disable
