# ─────────────────────────────────────────────────────────────
# MetaCI — Development Dockerfile (with hot reload via air)
# ─────────────────────────────────────────────────────────────

FROM golang:1.25-alpine

RUN apk add --no-cache git curl

# Install air for hot reload (pin to compatible version)
RUN go install github.com/air-verse/air@v1.61.7

WORKDIR /app

# Cache dependencies first
COPY go.mod go.sum ./
RUN go mod download

# Copy source
COPY . .

# Air config
COPY .air.toml .air.toml

EXPOSE 8080

CMD ["air", "-c", ".air.toml", "--", "serve", "--addr", ":8080", "--dir", "./examples/demo-mono"]
