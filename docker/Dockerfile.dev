# ─────────────────────────────────────────────────────────────
# Kestrix — Development Dockerfile (with hot reload via air)
# ─────────────────────────────────────────────────────────────

FROM golang:1.25-alpine

RUN apk add --no-cache bash git curl nodejs npm docker-cli build-base \
    && git config --global --add safe.directory /app

# Install air for hot reload (pin to compatible version)
RUN go install github.com/air-verse/air@v1.61.7

WORKDIR /app

# Cache dependencies first
COPY go.mod go.sum ./
RUN go mod download

# Copy source
COPY . .

# Air config
COPY .air.toml .air.toml

EXPOSE 8080

CMD ["air", "-c", ".air.toml", "--", "serve", "--addr", ":8080"]
