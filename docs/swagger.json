{
    "swagger": "2.0",
    "info": {
        "contact": {}
    },
    "paths": {
        "/": {
            "get": {
                "description": "Returns MetaCI server information and available endpoints",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "info"
                ],
                "summary": "MetaCI API root",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "description": "Returns server health status",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/webhook": {
            "post": {
                "description": "Receives a GitLab push event, evaluates the pipeline DAG against changed files, and optionally dispatches to GitLab runners",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "webhook"
                ],
                "summary": "Process GitLab push webhook",
                "parameters": [
                    {
                        "type": "string",
                        "description": "GitLab webhook secret token",
                        "name": "X-Gitlab-Token",
                        "in": "header"
                    },
                    {
                        "description": "GitLab push event payload",
                        "name": "payload",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "object"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_web.WebhookResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/internal_web.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/internal_web.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/internal_web.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "internal_web.DispatchInfo": {
            "type": "object",
            "properties": {
                "iid": {
                    "type": "integer"
                },
                "pipeline_id": {
                    "type": "integer"
                },
                "status": {
                    "type": "string"
                },
                "web_url": {
                    "type": "string"
                }
            }
        },
        "internal_web.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                }
            }
        },
        "internal_web.WebhookResponse": {
            "type": "object",
            "properties": {
                "branch": {
                    "type": "string"
                },
                "changed_repos": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "boolean"
                    }
                },
                "dispatch": {
                    "$ref": "#/definitions/internal_web.DispatchInfo"
                },
                "gitlab_ci": {
                    "type": "string"
                },
                "project": {
                    "type": "string"
                },
                "repo": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                },
                "tasks": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": true
                    }
                }
            }
        }
    }
}